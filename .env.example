# Copy to .env.local for development, and set the same values in Vercel.
#
# With none of these set, the booking page runs against the in-memory demo store
# in lib/demo-store.ts and the admin panel is sealed shut — /admin redirects to a
# login page that explains it is not connected. A missing variable can never
# leave the admin open.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Safe to ship to the browser. RLS is what protects the data and there are no
# anon policies. Used for staff login and all admin reads/writes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Used only by the public booking and cancellation route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile ---------------------------------------------------
# Bot protection on the public booking form. Until the secret is set,
# verification is skipped so local development works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend -----------------------------------------------------------------
# Both must be set or no email is sent. The sending domain needs SPF, DKIM and
# DMARC records or confirmations land in spam.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=bookings@irmak-restaurant.com

# --- Site --------------------------------------------------------------------
# Absolute base URL used to build cancellation links in emails. Falls back to
# VERCEL_URL, then localhost.
NEXT_PUBLIC_SITE_URL=https://irmak-restaurant.com
